<idea-plugin require-restart="true">
    <id>com.canbaycay.regionhighlights</id>
    <name>Region Highlights</name>
    <vendor>Can Baycay</vendor>
    <description><![CDATA[
        Coloring #region lines to make them easier to see in Rider. You might start to love Regions with this feature.
        <br/><br/>
        <img src="https://raw.githubusercontent.com/canbaycay/RegionHighlights/main/docs/screenshots/screenshot-simple.png"
             alt="Simple region highlighting"
             width="600"/>
        <br/><br/>
        Nested regions are rendered in a different color.
        <br/><br/>
        <img src="https://raw.githubusercontent.com/canbaycay/RegionHighlights/main/docs/screenshots/screenshot-nested.png"
             alt="Nested region highlighting"
             width="600"/>
        <br/><br/>
        Fully customizable colors and accent lines.
        <br/><br/>
        <img src="https://raw.githubusercontent.com/canbaycay/RegionHighlights/main/docs/screenshots/screenshot-config.png"
             alt="Settings panel"
             width="600"/>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.canbaycay.regionhighlights.RegionHighlightSettings"/>
        <applicationConfigurable instance="com.canbaycay.regionhighlights.RegionHighlightConfigurable"
                                 id="com.canbaycay.regionhighlights.settings"
                                 displayName="Region Highlights"
                                 parentId="editor"/>
        <editorFactoryListener implementation="com.canbaycay.regionhighlights.RegionHighlightManager"/>
    </extensions>
</idea-plugin>
